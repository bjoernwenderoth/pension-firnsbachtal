---
import site from "../data/site.json";
import { path } from "../utils/path";
import { Icon } from "astro-icon/components";
import "@fontsource/playfair-display";
import "@fontsource/inter";
import "../styles/global.css";
import ccLogo from "../assets/cc-logo.png";
import { Image } from "astro:assets";

import { getImage } from "astro:assets";
import defaultOgImage from "../assets/og-image.png";
import WhatsAppIcon from "../components/icons/WhatsAppIcon.astro";

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
}

const {
  title,
  description = "Urlaub im Haus Firnsbachtal in Schauenburg. Gemütliche Pension & Ferienwohnung direkt am Waldrand. Wandern im Habichtswald, Nähe Kassel & Bergpark Wilhelmshöhe.",
  image = defaultOgImage,
} = Astro.props;

const optimizedImage = await getImage({
  src: image,
  format: "jpg",
  width: 1200,
  height: 630,
  quality: 80,
});

const siteUrl = import.meta.env.SITE ?? "http://localhost:4321";
const imageUrl = new URL(optimizedImage.src, siteUrl).href;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const mailtoLink = `mailto:${site.contact.email}?subject=${encodeURIComponent(site.contact.email_template.subject)}&body=${encodeURIComponent(site.contact.email_template.body)}`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={path("favicon.svg")} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary -->
    <title>{title} | {site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={`${title} | ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={`${title} | ${site.name}`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageUrl} />
  </head>
  <body class="flex flex-col min-h-screen bg-bg-warm text-gray-800">
    <!-- Top Bar (Desktop only) -->
    <div class="bg-primary text-white text-xs py-2 px-4 hidden md:block">
      <div class="max-w-6xl mx-auto flex justify-between items-center">
        <div class="flex gap-6">
          <a
            href={`tel:${site.contact.phone}`}
            class="flex items-center gap-2 hover:text-accent transition"
            ><Icon name="lucide:phone" size={14} />
            {site.contact.phone_display}</a
          >
          <a
            href={mailtoLink}
            class="flex items-center gap-2 hover:text-accent transition"
            ><Icon name="lucide:mail" size={14} /> {site.contact.email}</a
          >
        </div>
        <a
          target="_blank"
          href={`https://wa.me/${site.contact.whatsapp.replace("+", "")}`}
          class="flex items-center gap-2 hover:text-green-300 transition"
        >
          <WhatsAppIcon size={14} /> WhatsApp</a
        >
      </div>
    </div>

    <!-- Navigation Header -->
    <header
      class="bg-bg-warm/95 backdrop-blur-md sticky top-0 z-40 border-b border-gray-200 shadow-sm"
    >
      <nav
        class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center"
      >
        <a
          href={path("/")}
          class="text-2xl font-serif font-bold text-primary tracking-tight z-50"
        >
          {site.name}
        </a>

        <ul
          class="hidden md:flex gap-8 text-sm font-medium text-gray-600 uppercase tracking-widest"
        >
          <li>
            <a href={path("/")} class="hover:text-primary transition">Home</a>
          </li>
          <li>
            <a href={path("zimmer")} class="hover:text-primary transition"
              >Zimmer & Preise</a
            >
          </li>
          <li>
            <a href={path("lage")} class="hover:text-primary transition"
              >Lage & Umgebung</a
            >
          </li>
          <li>
            <a href={path("kontakt")} class="hover:text-primary transition"
              >Kontakt</a
            >
          </li>
        </ul>

        <button
          id="menu-open-btn"
          class="md:hidden text-primary p-2 focus:outline-none"
          aria-label="Menü öffnen"
        >
          <Icon name="lucide:menu" size={28} />
        </button>
      </nav>
    </header>

    <!-- MOBILE MENU -->
    <div
      id="mobile-menu"
      class="fixed inset-0 z-50 bg-[#F9F7F2] transform translate-x-full transition-transform duration-300 ease-in-out md:hidden h-dvh w-full flex flex-col"
    >
      <div
        class="flex justify-between items-center p-4 border-b border-gray-200"
      >
        <span class="text-2xl font-serif font-bold text-primary"
          >{site.name}</span
        >
        <button
          id="menu-close-btn"
          class="text-primary p-2 focus:outline-none"
          aria-label="Menü schließen"
        >
          <Icon name="lucide:x" size={28} />
        </button>
      </div>

      <div class="flex-grow flex flex-col justify-center items-center gap-8">
        <ul
          class="flex flex-col gap-6 text-2xl font-serif text-primary text-center"
        >
          <li>
            <a
              href={path("/")}
              class="mobile-link hover:text-primary-light transition">Home</a
            >
          </li>
          <li>
            <a
              href={path("zimmer")}
              class="mobile-link hover:text-primary-light transition"
              >Zimmer & Preise</a
            >
          </li>
          <li>
            <a
              href={path("lage")}
              class="mobile-link hover:text-primary-light transition"
              >Lage & Umgebung</a
            >
          </li>
          <li>
            <a
              href={path("kontakt")}
              class="mobile-link hover:text-primary-light transition">Kontakt</a
            >
          </li>
        </ul>
      </div>

      <div class="p-8 bg-primary/5 text-center">
        <div class="flex justify-center gap-14 text-primary mb-6">
          <a
            href={`tel:${site.contact.phone}`}
            class="p-2 bg-white rounded-full shadow-sm hover:scale-110 transition"
            ><Icon name="lucide:phone" size={24} /></a
          >
          <a
            href={mailtoLink}
            class="p-2 bg-white rounded-full shadow-sm hover:scale-110 transition"
            ><Icon name="lucide:mail" size={24} /></a
          >
          <a
            href={`https://wa.me/${site.contact.whatsapp.replace("+", "")}`}
            class="p-2 bg-white rounded-full shadow-sm hover:scale-110 transition"
            ><WhatsAppIcon size={24} /></a
          >
        </div>
        <p class="text-xs text-gray-500">Mitten im Habichtswald</p>
      </div>
    </div>

    <main class="flex-grow w-full">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-primary text-white py-12 mt-auto">
      <div
        class="max-w-6xl mx-auto px-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 md:gap-12"
      >
        <!-- Spalte 1: Info (Nimmt 4 von 12 Teilen) -->
        <div class="lg:col-span-4">
          <h3 class="font-serif text-xl mb-4">{site.name}</h3>
          <p class="text-white/80 text-sm leading-relaxed">
            {site.tagline}
          </p>
        </div>

        <!-- Spalte 2: Kontakt (Nimmt 3 von 12 Teilen) -->
        <div class="lg:col-span-3">
          <h3 class="font-serif text-xl mb-4">Kontakt</h3>
          <ul class="space-y-2 text-sm text-white/80">
            <li>{site.address.street}</li>
            <li>{site.address.zip} {site.address.city}</li>
            <li class="pt-2">
              <a href={`tel:${site.contact.phone}`}
                >Tel.: {site.contact.phone_display}</a>
            </li>
          </ul>
        </div>

        <!-- Spalte 3: Links (Nimmt nur 2 von 12 Teilen -->
        <div class="lg:col-span-2">
          <h3 class="font-serif text-xl mb-4">Links</h3>
          <ul class="space-y-2 text-sm text-white/80">
            <li>
              <a href={path("impressum")} class="hover:text-accent"
                >Impressum</a>
            </li>
            <li>
              <a href={path("datenschutz")} class="hover:text-accent"
                >Datenschutz</a>
            </li>
          </ul>
        </div>

        <!-- Spalte 4: Webdesign (Nimmt 3 von 12 Teilen & Zentriert) -->

        <div class="lg:col-span-3 flex flex-col items-center text-center">
          <a
            href="https://bjoern-wenderoth.de/"
            target="_blank"
            rel="noopener"
            class="flex flex-col items-center group"
          >
            <!-- Logo Bild -->
            <Image
              src={ccLogo}
              alt="Creative & Code - Björn Wenderoth"
              width={140}
              class="mb-3 opacity-70 group-hover:opacity-100 transition duration-300"
            />
            <span
              class="text-[10px] uppercase tracking-wider text-white/50 group-hover:text-white/90 transition"
            >
              Made by Björn Wenderoth
            </span>
          </a>
        </div>
      </div>

      <div
        class="text-center text-xs text-white/40 mt-12 border-t border-white/10 pt-6"
      >
        &copy; {new Date().getFullYear()}
        {site.name}. Alle Rechte vorbehalten.
      </div>
    </footer>

    <script>
      const openBtn = document.getElementById("menu-open-btn");
      const closeBtn = document.getElementById("menu-close-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      const mobileLinks = document.querySelectorAll(".mobile-link");

      function openMenu() {
        mobileMenu?.classList.remove("translate-x-full");
        document.body.style.overflow = "hidden";
      }

      function closeMenu() {
        mobileMenu?.classList.add("translate-x-full");
        document.body.style.overflow = "";
      }

      if (openBtn) openBtn.addEventListener("click", openMenu);
      if (closeBtn) closeBtn.addEventListener("click", closeMenu);

      mobileLinks.forEach((link) => {
        link.addEventListener("click", closeMenu);
      });
    </script>
  </body>
</html>
