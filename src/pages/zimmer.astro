---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";

import { Image } from "astro:assets";
import { Wifi, Tv, ShowerHead, Coffee, Sun, Radio, Phone } from "lucide-astro";

import imgSingle from "../assets/zimmer_1.jpg";
import imgDouble from "../assets/zimmer_2.jpg";

import gallery1 from "../assets/haus_garten.jpg";
import gallery2 from "../assets/haus_garten2.jpg";
import gallery3 from "../assets/haus_parkplatz.jpg";
import gallery4 from "../assets/haus_nacht.jpg";
import ogZimemer from "../assets/og-zimmer.png";

const amenities = [
  { icon: ShowerHead, label: "Dusche & WC" },
  { icon: Tv, label: "TV Gerät" },
  { icon: Wifi, label: "Kostenloses WLAN" },
  { icon: Phone, label: "Telefon" },
  { icon: Radio, label: "Radio" },
  { icon: Coffee, label: "Minibar" },
  { icon: Sun, label: "Teilw. Terrasse" },
];
---

<Layout
  title="Zimmer & Preise | Übernachtung Schauenburg"
  description=`Gemütliche Einzel- & Doppelzimmer ab ${site.prices.single}€. Inkl. Frühstück, WLAN & Parkplatz. Ideal für Monteure, Wanderer und Kurzurlauber im Habichtswald.`
  image={ogZimemer}
>
  <!-- Header Hero (ohne Bogen) -->
  <div
    class="bg-primary pt-32 pb-20 text-center text-white relative overflow-hidden"
  >
    <h1 class="text-4xl md:text-6xl font-serif font-bold mb-6 relative z-10">
      Wohlfühlen wie Zuhause
    </h1>
    <p
      class="text-white/80 max-w-2xl mx-auto px-4 text-lg font-light relative z-10"
    >
      Helle Räume, gemütliche Betten und der Blick ins Grüne. Treten Sie ein und
      lassen Sie den Alltag hinter sich.
    </p>
  </div>

  <!-- Intro Text & Galerie -->
  <section class="py-20 max-w-6xl mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl font-serif text-primary mb-6">
        Einblicke in unser Haus
      </h2>
      <p class="text-gray-600 leading-relaxed">
        Unsere Zimmer sind teils im angenehm kühlen Souterrain gelegen – ein
        Segen an heißen Sommertagen. Jedes Zimmer ist individuell und liebevoll
        eingerichtet, damit Sie sich sofort geborgen fühlen.
      </p>
    </div>

    <!-- BENTO GRID GALERIE -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 auto-rows-[250px]">
      <!-- Bild 1: Groß (Haus/Außen) - Spans 2 cols, 2 rows -->
      <div
        class="md:col-span-2 md:row-span-2 relative group overflow-hidden rounded-2xl"
      >
        <Image
          src={gallery1}
          alt="Außenansicht Haus Firnsbachtal"
          class="w-full h-full object-cover transition duration-700 group-hover:scale-105"
        />
        <div
          class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition"
        >
        </div>
      </div>

      <!-- Bild 2: Detail -->
      <div class="relative group overflow-hidden rounded-2xl">
        <Image
          src={gallery2}
          alt="Liebevolle Details"
          class="w-full h-full object-cover transition duration-700 group-hover:scale-105"
        />
      </div>

      <!-- Bild 3: Bad -->
      <div class="relative group overflow-hidden rounded-2xl">
        <Image
          src={gallery3}
          alt="Modernes Badezimmer"
          class="w-full h-full object-cover transition duration-700 group-hover:scale-105"
        />
      </div>

      <!-- Bild 4: Ausblick - Spans 2 cols wide (unten rechts) -->
      <div class="md:col-span-2 relative group overflow-hidden rounded-2xl">
        <Image
          src={gallery4}
          alt="Blick ins Grüne"
          class="w-full h-full object-cover transition duration-700 group-hover:scale-105"
        />
        <div
          class="absolute bottom-4 left-4 bg-white/90 backdrop-blur px-4 py-2 rounded-lg text-xs font-bold text-primary shadow-sm"
        >
          Ruhe & Natur
        </div>
      </div>
    </div>
  </section>

  <!-- Content Cards -->
  <section class="pb-20 pt-10 max-w-5xl mx-auto px-4">
    <h2 class="text-3xl font-serif text-center text-primary mb-12">
      Unsere Angebote
    </h2>

    <div class="grid md:grid-cols-2 gap-12">
      <!-- Einzelzimmer Card -->
      <div
        class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100 flex flex-col hover:shadow-2xl transition duration-300"
      >
        <div class="h-64 overflow-hidden relative">
          <Image
            src={imgSingle}
            alt="Einzelzimmer"
            class="w-full h-full object-cover hover:scale-105 transition duration-700"
          />
          <div
            class="absolute top-4 right-4 bg-primary text-white text-xs font-bold px-3 py-1 rounded-full"
          >
            Beliebt
          </div>
        </div>
        <div class="p-8 flex-grow flex flex-col">
          <div class="flex justify-between items-baseline mb-2">
            <h3 class="text-2xl font-serif text-primary">Einzelzimmer</h3>
          </div>
          <p class="text-gray-500 mb-6 text-sm">
            Ihr privater Rückzugsort. Ideal für Geschäftsreisende, Monteure oder
            Solo-Wanderer.
          </p>

          <div class="grid grid-cols-2 gap-y-3 gap-x-2 mb-8">
            {
              amenities.map((item) => (
                <div class="flex items-center gap-2 text-gray-600 text-sm">
                  <item.icon size={16} class="text-primary-light shrink-0" />
                  <span>{item.label}</span>
                </div>
              ))
            }
          </div>

          <div
            class="mt-auto border-t border-gray-100 pt-6 flex items-end justify-between"
          >
            <div>
              <span class="text-xs text-gray-400 block uppercase tracking-wider"
                >Preis pro Nacht</span
              >
              <div class="flex items-baseline gap-1">
                <span class="text-3xl font-bold text-primary"
                  >{site.prices.single} €</span
                >
                <span class="text-sm text-gray-500">inkl. Frühstück*</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Doppelzimmer Card -->
      <div
        class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100 flex flex-col hover:shadow-2xl transition duration-300"
      >
        <div class="h-64 overflow-hidden relative">
          <Image
            src={imgDouble}
            alt="Doppelzimmer"
            class="w-full h-full object-cover hover:scale-105 transition duration-700"
          />
        </div>
        <div class="p-8 flex-grow flex flex-col">
          <div class="flex justify-between items-baseline mb-2">
            <h3 class="text-2xl font-serif text-primary">Doppelzimmer</h3>
          </div>
          <p class="text-gray-500 mb-6 text-sm">
            Viel Platz für zwei. Genießen Sie gemeinsame Zeit in gemütlichem
            Ambiente nach einem Wandertag.
          </p>

          <div class="grid grid-cols-2 gap-y-3 gap-x-2 mb-8">
            {
              amenities.map((item) => (
                <div class="flex items-center gap-2 text-gray-600 text-sm">
                  <item.icon size={16} class="text-primary-light shrink-0" />
                  <span>{item.label}</span>
                </div>
              ))
            }
          </div>

          <div
            class="mt-auto border-t border-gray-100 pt-6 flex items-end justify-between"
          >
            <div>
              <span class="text-xs text-gray-400 block uppercase tracking-wider"
                >Preis pro Nacht</span
              >
              <div class="flex items-baseline gap-1">
                <span class="text-3xl font-bold text-primary"
                  >{site.prices.double} €</span
                >
                <span class="text-sm text-gray-500">inkl. Frühstück*</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Info Box Small -->
    <div
      class="mt-12 text-center text-sm text-gray-500 bg-nature-50 p-4 rounded-lg inline-block w-full"
    >
      * Alle Preise verstehen sich inklusive der gesetzlichen Mehrwertsteuer.
    </div>

    <!-- CTA Area -->
    <div
      class="mt-16 bg-primary rounded-3xl p-8 md:p-12 text-center text-white relative overflow-hidden"
    >
      <div class="relative z-10">
        <h3 class="text-2xl md:text-3xl font-serif mb-4">
          Haben Sie Ihren Wunschtermin gefunden?
        </h3>
        <p class="mb-8 text-white/80 max-w-xl mx-auto">
          Wir beraten Sie gerne persönlich. Rufen Sie uns einfach an oder
          schreiben Sie uns per WhatsApp.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a
            href={`tel:${site.contact.phone}`}
            class="bg-white text-primary font-bold py-3 px-8 rounded-full hover:bg-gray-100 transition flex items-center justify-center gap-2"
          >
            <Phone size={18} />
            {site.contact.phone_display}
          </a>
          <a
            href={`https://wa.me/${site.contact.whatsapp.replace("+", "")}`}
            class="bg-[#25D366] text-white font-bold py-3 px-8 rounded-full hover:bg-[#20bd5a] transition flex items-center justify-center gap-2"
          >
            WhatsApp Nachricht
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
