---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";
import { Wifi, Tv, ShowerHead, Coffee, Sun, Radio, Phone } from "lucide-astro";

const amenities = [
  { icon: ShowerHead, label: "Dusche & WC" },
  { icon: Tv, label: "TV" },
  { icon: Wifi, label: "WLAN" },
  { icon: Phone, label: "Telefon" },
  { icon: Radio, label: "Radio" },
  { icon: Coffee, label: "Minibar" },
  { icon: Sun, label: "Teilw. Terrasse" },
];
---

<Layout title="Zimmer & Preise">
  <!-- Header -->
  <div class="bg-primary py-20 text-center text-white">
    <h1 class="text-4xl md:text-5xl font-bold mb-4">Zimmer & Preise</h1>
    <p class="text-white/80 max-w-2xl mx-auto px-4">
      Übernachten Sie in unseren großzügigen, liebevoll eingerichteten Einzel-
      und Doppelzimmern. Teilweise im angenehm kühlen Souterrain gelegen –
      perfekt für heiße Sommertage.
    </p>
  </div>

  <!-- Content -->
  <section class="py-20 max-w-5xl mx-auto px-4">
    <div class="grid md:grid-cols-2 gap-12">
      <!-- Einzelzimmer Card -->
      <div
        class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100 flex flex-col"
      >
        <div class="h-64 bg-gray-200 overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1611892440504-42a792e24d32?q=80&w=2070&auto=format&fit=crop"
            class="w-full h-full object-cover hover:scale-105 transition duration-700"
            alt="Einzelzimmer"
          />
        </div>
        <div class="p-8 flex-grow flex flex-col">
          <h2 class="text-2xl font-serif text-primary mb-2">Einzelzimmer</h2>
          <p class="text-gray-500 mb-6 text-sm">
            Ihr privater Rückzugsort für Erholungssuchende und
            Geschäftsreisende.
          </p>

          <div class="grid grid-cols-2 gap-3 mb-8">
            {
              amenities.map((item) => (
                <div class="flex items-center gap-2 text-gray-600 text-sm">
                  <item.icon size={16} class="text-primary-light" />
                  <span>{item.label}</span>
                </div>
              ))
            }
          </div>

          <div
            class="mt-auto border-t border-gray-100 pt-6 flex items-end justify-between"
          >
            <div>
              <span class="text-xs text-gray-400 block">pro Nacht</span>
              <span class="text-3xl font-bold text-primary"
                >{site.prices.single} €</span
              >
            </div>
            <span
              class="text-xs text-gray-500 bg-nature-50 px-3 py-1 rounded-full"
              >*inkl. Frühstück</span
            >
          </div>
        </div>
      </div>

      <!-- Doppelzimmer Card -->
      <div
        class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100 flex flex-col"
      >
        <div class="h-64 bg-gray-200 overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1590490360182-c33d57733427?q=80&w=1974&auto=format&fit=crop"
            class="w-full h-full object-cover hover:scale-105 transition duration-700"
            alt="Doppelzimmer"
          />
        </div>
        <div class="p-8 flex-grow flex flex-col">
          <h2 class="text-2xl font-serif text-primary mb-2">Doppelzimmer</h2>
          <p class="text-gray-500 mb-6 text-sm">
            Viel Platz für zwei. Genießen Sie gemeinsame Zeit in gemütlichem
            Ambiente.
          </p>

          <div class="grid grid-cols-2 gap-3 mb-8">
            {
              amenities.map((item) => (
                <div class="flex items-center gap-2 text-gray-600 text-sm">
                  <item.icon size={16} class="text-primary-light" />
                  <span>{item.label}</span>
                </div>
              ))
            }
          </div>

          <div
            class="mt-auto border-t border-gray-100 pt-6 flex items-end justify-between"
          >
            <div>
              <span class="text-xs text-gray-400 block">pro Nacht</span>
              <span class="text-3xl font-bold text-primary"
                >{site.prices.double} €</span
              >
            </div>
            <span
              class="text-xs text-gray-500 bg-nature-50 px-3 py-1 rounded-full"
              >*inkl. Frühstück</span
            >
          </div>
        </div>
      </div>
    </div>

    <div
      class="mt-16 text-center bg-bg-warm p-8 rounded-xl border border-primary/10"
    >
      <h3 class="text-xl font-serif text-primary mb-4">Interesse geweckt?</h3>
      <p class="mb-6 text-gray-600">
        Wir freuen uns darauf, Sie als unsere Gäste begrüßen zu dürfen. <br
        />Rufen Sie uns an oder schreiben Sie uns.
      </p>
      <div class="flex justify-center gap-4 flex-wrap">
        <a
          href={`tel:${site.contact.phone}`}
          class="bg-primary text-white py-2 px-6 rounded-full hover:bg-primary/90 transition flex items-center gap-2"
        >
          <Phone size={18} />
          {site.contact.phone_display}
        </a>
        <a
          href={`https://wa.me/${site.contact.whatsapp.replace("+", "")}`}
          class="bg-green-500 text-white py-2 px-6 rounded-full hover:bg-green-600 transition flex items-center gap-2"
        >
          WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>
