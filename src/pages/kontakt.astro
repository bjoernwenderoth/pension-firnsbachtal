---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";
import { Phone, Mail, MapPin, Clock, MessageCircle } from "lucide-astro";
---

<Layout title="Kontakt">
  <div class="bg-bg-warm min-h-[50vh] py-20">
    <div class="max-w-4xl mx-auto px-4">
      <h1
        class="text-4xl md:text-5xl font-serif text-primary text-center mb-12"
      >
        Kontakt & Anfahrt
      </h1>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Info Box -->
        <div class="bg-white p-8 rounded-2xl shadow-lg">
          <h2 class="text-2xl font-serif mb-6 text-gray-800">
            Hier finden Sie uns
          </h2>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="bg-nature-50 p-3 rounded-full text-primary">
                <MapPin />
              </div>
              <div>
                <h3 class="font-bold text-gray-900">Adresse</h3>
                <p class="text-gray-600">
                  {site.name}<br />
                  {site.address.street}<br />
                  {site.address.zip}
                  {site.address.city}
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="bg-nature-50 p-3 rounded-full text-primary">
                <Phone />
              </div>
              <div>
                <h3 class="font-bold text-gray-900">Telefon</h3>
                <p class="text-gray-600 mb-1">
                  Für Buchungsanfragen rufen Sie uns gerne an:
                </p>
                <a
                  href={`tel:${site.contact.phone}`}
                  class="text-lg font-bold text-primary hover:underline"
                  >{site.contact.phone_display}</a
                >
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="bg-nature-50 p-3 rounded-full text-primary">
                <Mail />
              </div>
              <div>
                <h3 class="font-bold text-gray-900">E-Mail</h3>
                <a
                  href={`mailto:${site.contact.email}`}
                  class="text-primary hover:underline">{site.contact.email}</a
                >
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="bg-nature-50 p-3 rounded-full text-green-600">
                <MessageCircle />
              </div>
              <div>
                <h3 class="font-bold text-gray-900">WhatsApp</h3>
                <p class="text-gray-600 text-sm mb-1">
                  Schnell und unkompliziert:
                </p>
                <a
                  href={`https://wa.me/${site.contact.whatsapp.replace("+", "")}`}
                  class="text-green-600 font-bold hover:underline"
                  >Chat starten</a
                >
              </div>
            </div>
          </div>
        </div>

        <!-- Formular Platzhalter (Statisch, da kein Backend definiert) -->
        <div class="bg-white p-8 rounded-2xl shadow-lg">
          <h2 class="text-2xl font-serif mb-6 text-gray-800">Anfrage senden</h2>
          <form
            class="space-y-4"
            onsubmit="event.preventDefault(); alert('Dies ist eine Demo. Bitte nutzen Sie Telefon oder E-Mail.');"
          >
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Name</label
              >
              <input
                type="text"
                class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-primary focus:border-primary outline-none"
                placeholder="Ihr Name"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >E-Mail</label
              >
              <input
                type="email"
                class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-primary focus:border-primary outline-none"
                placeholder="ihre@email.de"
              />
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1"
                  >Anreise</label
                >
                <input
                  type="date"
                  class="w-full border border-gray-300 rounded-lg p-3 outline-none"
                />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1"
                  >Abreise</label
                >
                <input
                  type="date"
                  class="w-full border border-gray-300 rounded-lg p-3 outline-none"
                />
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Nachricht</label
              >
              <textarea
                rows="4"
                class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-primary focus:border-primary outline-none"
                placeholder="Ich interessiere mich für..."></textarea>
            </div>
            <button
              type="submit"
              class="w-full bg-primary text-white font-bold py-3 rounded-lg hover:bg-primary/90 transition"
              >Anfrage absenden</button
            >
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Große Karte unten -->
  <section class="h-[400px] w-full bg-gray-200 mt-12">
    <iframe
      src={site.map_url}
      width="100%"
      height="100%"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"></iframe>
  </section>
</Layout>
