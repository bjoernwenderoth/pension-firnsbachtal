---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";
import {
  Phone,
  Mail,
  MapPin,
  Clock,
  MessageCircle,
  ArrowRight,
  Car,
  Navigation,
} from "lucide-astro";
import PrivacyMap from "../components/PrivacyMap.astro";
---

<Layout
  title="Kontakt & Anfahrt | Haus Firnsbachtal buchen"
  description="Buchen Sie direkt beim Gastgeber. Rufen Sie uns an oder schreiben Sie per WhatsApp. Hier finden Sie Adresse, Anfahrt und Check-in Zeiten."
>
  <div
    class="bg-primary pt-32 pb-40 text-center text-white relative overflow-hidden"
  >
    <div
      class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"
    >
    </div>
    <h1 class="text-4xl md:text-6xl font-serif font-bold mb-6 relative z-10">
      Wir sind für Sie da
    </h1>
    <p
      class="text-white/80 max-w-2xl mx-auto px-4 text-lg font-light relative z-10"
    >
      Persönlich. Direkt. Unkompliziert.<br />
    </p>
  </div>

  <section class="pb-20 px-4 max-w-6xl mx-auto -mt-20 relative z-20">
    <div class="grid md:grid-cols-3 gap-6">
      <div
        class="bg-white p-8 rounded-2xl shadow-xl border border-gray-100 flex flex-col items-center text-center transition duration-300"
      >
        <div
          class="w-16 h-16 bg-nature-50 rounded-full flex items-center justify-center text-primary mb-6"
        >
          <Phone size={32} />
        </div>
        <h3 class="text-xl font-serif font-bold text-gray-800 mb-2">Anrufen</h3>
        <p class="text-gray-500 text-sm mb-6 leading-relaxed">
          Am schnellsten klären wir Verfügbarkeiten und Fragen in einem kurzen
          Telefonat.
        </p>
        <a
          href={`tel:${site.contact.phone}`}
          class="mt-auto bg-primary text-white py-3 px-6 rounded-full font-bold hover:bg-primary/90 transition flex items-center gap-2"
        >
          {site.contact.phone_display}
        </a>
      </div>

      <div
        class="bg-white p-8 rounded-2xl shadow-xl border border-gray-100 flex flex-col items-center text-center transition duration-300"
      >
        <div
          class="w-16 h-16 bg-green-50 rounded-full flex items-center justify-center text-[#25D366] mb-6"
        >
          <MessageCircle size={32} />
        </div>
        <h3 class="text-xl font-serif font-bold text-gray-800 mb-2">
          WhatsApp
        </h3>
        <p class="text-gray-500 text-sm mb-6 leading-relaxed">
          Schreiben Sie uns ganz bequem von unterwegs. Wir antworten so schnell
          wie möglich.
        </p>
        <a
          href={`https://wa.me/${site.contact.whatsapp.replace("+", "")}`}
          target="_blank"
          class="mt-auto bg-[#25D366] text-white py-3 px-6 rounded-full font-bold hover:bg-[#20bd5a] transition flex items-center gap-2"
        >
          Chat starten <ArrowRight size={16} />
        </a>
      </div>

      <div
        class="bg-white p-8 rounded-2xl shadow-xl border border-gray-100 flex flex-col items-center text-center transition duration-300"
      >
        <div
          class="w-16 h-16 bg-nature-50 rounded-full flex items-center justify-center text-primary mb-6"
        >
          <Mail size={32} />
        </div>
        <h3 class="text-xl font-serif font-bold text-gray-800 mb-2">E-Mail</h3>
        <p class="text-gray-500 text-sm mb-6 leading-relaxed">
          Sie planen länger im Voraus oder benötigen ein Angebot? Schreiben Sie
          uns.
        </p>
        <a
          href={`mailto:${site.contact.email}`}
          class="mt-auto text-primary font-bold border-2 border-primary py-3 px-6 rounded-full hover:bg-primary hover:text-white transition flex items-center gap-2"
        >
          E-Mail schreiben
        </a>
      </div>
    </div>
  </section>

  <section class="pb-20 bg-bg-warm pt-10">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div
            class="flex items-center gap-2 text-primary font-bold uppercase tracking-widest text-sm mb-4"
          >
            <MapPin size={16} /> Anreise
          </div>
          <h2 class="text-3xl md:text-4xl font-serif text-gray-800 mb-8">
            So finden Sie zu uns
          </h2>

          <div
            class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 mb-8"
          >
            <address class="not-italic text-lg text-gray-700 leading-relaxed">
              <strong class="text-primary block mb-1">{site.name}</strong>
              {site.address.street}<br />
              {site.address.zip}
              {site.address.city}
            </address>
            <div class="mt-4 pt-4 border-t border-gray-100 flex gap-4">
              <a
                href={`https://www.google.com/maps/dir/?api=1&destination=${site.address.street},+${site.address.zip}+${site.address.city}`}
                target="_blank"
                class="text-primary text-sm font-bold flex items-center gap-1 hover:underline"
              >
                <Navigation size={14} /> Route planen (Google Maps)
              </a>
            </div>
          </div>

          <div class="flex gap-4 items-start">
            <div
              class="p-3 bg-white rounded-full text-primary shadow-sm shrink-0"
            >
              <Clock size={24} />
            </div>
            <div>
              <h3 class="font-bold text-gray-800">Check-in & Check-out</h3>
              <p class="text-gray-600 text-sm mt-1">
                Anreise: ab 15:00 Uhr (oder nach Absprache)<br />
                Abreise: bis 10:30 Uhr
              </p>
            </div>
          </div>

          <div class="flex gap-4 items-start mt-6">
            <div
              class="p-3 bg-white rounded-full text-primary shadow-sm shrink-0"
            >
              <Car size={24} />
            </div>
            <div>
              <h3 class="font-bold text-gray-800">Parken</h3>
              <p class="text-gray-600 text-sm mt-1">
                Kostenlose Parkplätze befinden sich direkt am Haus.
              </p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl overflow-hidden shadow-lg">
          <PrivacyMap url={site.map_url} height="h-[500px]" />
        </div>
      </div>
    </div>
  </section>
</Layout>
