---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";
import { Icon } from "astro-icon/components";
import { path } from "../utils/path";
import { Image } from "astro:assets";
import forest from "../assets/forest.jpg";
import home from "../assets/home.png";
import PrivacyMap from "../components/PrivacyMap.astro";
---

<Layout
  title="Pension & Ferienwohnung im Habichtswald"
  description="Erholung pur in Schauenburg. Gemütliche Unterkunft direkt am Waldrand. Nur 20 Min. zum Bergpark Wilhelmshöhe & Kassel. Perfekt für Wanderer."
>
  <!-- HERO SECTION -->
  <div
    class="relative h-[85vh] flex items-center justify-center overflow-hidden"
  >
    <Image
      src={home}
      alt="Pensionhaus Firnsbachtal"
      class="absolute inset-0 w-full h-full object-cover"
    />

    <div class="absolute inset-0 bg-black/30"></div>

    <div class="relative z-10 text-center text-white px-4 max-w-4xl fade-in-up">
      <span
        class="uppercase tracking-[0.3em] text-sm md:text-base mb-4 block text-accent"
        >Fremdenzimmer</span
      >
      <h1
        class="text-5xl md:text-7xl font-bold mb-6 leading-tight drop-shadow-lg"
      >
        Ankommen im <br />
        <span class="text-accent italic">Habichtswald</span>
      </h1>
      <p class="text-lg md:text-xl mb-10 max-w-2xl mx-auto text-white/90">
        Erleben Sie unberührte Natur direkt vor der Haustür. Ihr perfekter
        Ausgangspunkt für Wanderungen, Kultur in Kassel und pure Erholung.
      </p>
      <div class="flex flex-col md:flex-row gap-4 justify-center">
        <a
          href={path("/zimmer")}
          class="bg-bg-warm text-primary font-bold py-3 px-8 rounded-full hover:bg-white transition duration-300"
        >
          Zimmer ansehen
        </a>
        <a
          href={path("/kontakt")}
          class="bg-primary/80 backdrop-blur-sm text-white border border-white/30 font-bold py-3 px-8 rounded-full hover:bg-primary transition duration-300"
        >
          Jetzt anfragen
        </a>
      </div>
    </div>
  </div>

  <!-- INTRO SECTION -->
  <section class="py-24 px-4 bg-warm">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl text-primary mb-8">
        Ein Haus mit Herz in Schauenburg
      </h2>
      <div class="prose prose-lg mx-auto text-gray-600 leading-relaxed">
        <p>
          Willkommen in Ihrer Auszeit. Unser liebevoll geführtes Haus liegt
          idyllisch eingebettet zwischen Elgershausen und Hoof, direkt in einem
          der malerischsten Täler des Habichtswaldes.
        </p>
        <p>
          Bei uns beginnt die Erholung schon beim Blick aus dem Fenster. Die
          direkte Waldlage verspricht absolute Ruhe, während Sie gleichzeitig in
          nur wenigen Minuten mitten im Leben sind. Ob Sie den weltberühmten <strong
            >Bergpark Wilhelmshöhe</strong
          > mit dem Herkules erkunden, im <strong>Landgasthaus Herbsthäuschen</strong> einkehren
          oder in der <strong>Kurhessentherme</strong> entspannen möchten – von hier
          aus liegen Ihnen die Schätze Nordhessens zu Füßen.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12 not-prose">
          <div class="flex flex-col items-center gap-3">
            <div class="p-4 bg-nature-50 rounded-full text-primary">
              <Icon name="lucide:tree-pine" size={32} />
            </div>
            <h3 class="font-serif text-lg">Direkte Waldlage</h3>
            <p class="text-sm">Wanderwege starten direkt vor der Haustür.</p>
          </div>
          <div class="flex flex-col items-center gap-3">
            <div class="p-4 bg-nature-50 rounded-full text-primary">
              <Icon name="lucide:coffee" size={32} />
            </div>
            <h3 class="font-serif text-lg">Gemütliches Ambiente</h3>
            <p class="text-sm">Fühlen Sie sich wie zu Hause.</p>
          </div>
          <div class="flex flex-col items-center gap-3">
            <div class="p-4 bg-nature-50 rounded-full text-primary">
              <Icon name="lucide:map-pin" size={32} />
            </div>
            <h3 class="font-serif text-lg">Zentral & Ruhig</h3>
            <p class="text-sm">20 Min. nach Kassel & zum ICE-Bahnhof.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LOCATION HIGHLIGHT (Firnsbachtal) -->
  <section id="lage" class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-12 items-center">
      <div class="order-2 md:order-1">
        <!-- Bild Platzhalter: Wald / Bach -->
        <Image
          src={forest}
          class="rounded-2xl shadow-xl w-full h-auto object-cover"
          alt="Firnsbachtal Natur"
        />
      </div>
      <div class="order-1 md:order-2">
        <span class="text-primary font-bold tracking-widest uppercase text-sm"
          >Die Umgebung</span
        >
        <h2 class="text-4xl text-primary mt-2 mb-6">
          Das magische Firnsbachtal
        </h2>
        <p class="text-gray-600 mb-6 leading-relaxed">
          Unsere Pension liegt im Herzen des Firnsbachtals, einem echten
          Geheimtipp für Naturliebhaber. Das Rauschen des Firnsbachs und die
          dichten Buchenwälder schaffen ein Mikroklima, das Körper und Geist
          sofort entschleunigt.
        </p>
        <p class="text-gray-600 mb-8 leading-relaxed">
          Aktivurlauber finden hier ihr Paradies: Der Premiumwanderweg <strong
            >Habichtswaldsteig</strong
          > verläuft in unmittelbarer Nähe. Mountainbiker lieben die sanften Anstiege,
          und wer es ruhiger mag, genießt einen Spaziergang im Schatten alter Eichen.
        </p>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-gray-700">
            <Icon name="lucide:footprints" class="text-primary-light w-6 h-6" /> Direkter Zugang zu Premium-Wanderwegen
          </li>
          <li class="flex items-center gap-3 text-gray-700">
            <Icon name="lucide:map-pin" class="text-primary-light w-6 h-6" /> Nur 20 Minuten zur UNESCO Welterbe
            Bergpark
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- REVIEWS (Simple & Clean) -->
  <section class="py-24 bg-[#F9F7F2]">
    <div class="max-w-6xl mx-auto px-4">
      <!-- Header: Zentriert & Klar -->
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-serif text-primary mb-4">
          Das sagen unsere Gäste
        </h2>
        <div
          class="inline-flex items-center gap-2 bg-white px-4 py-2 rounded-full shadow-sm border border-gray-100"
        >
          <span class="font-bold text-gray-800">4.9</span>
          <div class="flex gap-1 text-yellow-400">
            <Icon name="heroicons:star-solid" fill="currentColor" size={16} /><Icon name="heroicons:star-solid" 
              fill="currentColor"
              size={16}
            /><Icon name="heroicons:star-solid"  fill="currentColor" size={16} /><Icon name="heroicons:star-solid" 
              fill="currentColor"
              size={16}
            /><Icon name="heroicons:star-solid"  fill="currentColor" size={16} />
          </div>
          <div
            class="flex items-center gap-1 text-xs text-gray-500 ml-1 border-l pl-3 border-gray-300"
          >
            <a href={site.rating} target="_blank" class="flex gap-1">
              <span>Google Rezensionen</span>
              <Icon name="lucide:arrow-right" 
                size={14}
                class="text-primary group-hover:translate-x-1 transition-transform"
              />
            </a>
          </div>
        </div>
      </div>

      <!-- Grid: 3 Saubere Karten -->
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Review 1 -->
        <div
          class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 flex flex-col"
        >
          <div class="flex gap-1 text-yellow-400 mb-4">
            <Icon name="heroicons:star-solid" fill="currentColor" size={16} /><Icon name="heroicons:star-solid" 
              fill="currentColor"
              size={16}
            /><Icon name="heroicons:star-solid"  fill="currentColor" size={16} /><Icon name="heroicons:star-solid" 
              fill="currentColor"
              size={16}
            /><Icon name="heroicons:star-solid"  fill="currentColor" size={16} />
          </div>
          <p class="text-gray-600 italic leading-relaxed mb-6 flex-grow">
            "Eine schöne, kleine Pension, die sich hervorragend eignet
            Urlaubsgäste unterzubringen oder auch selbst ein paar Tage zu
            verbringen. Sehr freundlich. Kinder sind gern gesehen. Gut gelegen,
            man sollte ein Auto haben. Es können von dort aus tolle Ausflüge
            gemacht werden. Das Gelände lädt auch zum Spielen und Verweilen
            ein."
          </p>
          <div class="pt-4 border-t border-gray-50">
            <p class="font-bold text-gray-900 text-sm">Martine H.</p>
          </div>
        </div>

        <!-- Review 2 -->
        <div
          class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 flex flex-col"
        >
          <div class="flex gap-1 text-yellow-400 mb-4">
            <Icon name="heroicons:star-solid" fill="currentColor" size={16} /><Icon name="heroicons:star-solid" 
              fill="currentColor"
              size={16}
            /><Icon name="heroicons:star-solid"  fill="currentColor" size={16} /><Icon name="heroicons:star-solid" 
              fill="currentColor"
              size={16}
            /><Icon name="heroicons:star-solid"  fill="currentColor" size={16} />
          </div>
          <p class="text-gray-600 italic leading-relaxed mb-6 flex-grow">
            "Die Familie ist sehr nett und hilfsbereit, die Zimmer hell und
            sauber. Der Gartenbereich ist toll angelegt und das Frühstück
            einfach super! Hier fühlt man sich sofort wohl!"
          </p>
          <div class="pt-4 border-t border-gray-50">
            <p class="font-bold text-gray-900 text-sm">Roland S.</p>
          </div>
        </div>

        <!-- Review 3 -->
        <div
          class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 flex flex-col"
        >
          <div class="flex gap-1 text-yellow-400 mb-4">
            <Icon name="heroicons:star-solid" fill="currentColor" size={16} /><Icon name="heroicons:star-solid" 
              fill="currentColor"
              size={16}
            /><Icon name="heroicons:star-solid"  fill="currentColor" size={16} /><Icon name="heroicons:star-solid" 
              fill="currentColor"
              size={16}
            /><Icon name="heroicons:star-solid"  fill="currentColor" size={16} />
          </div>

          <p class="text-gray-600 italic leading-relaxed mb-6 flex-grow">
            "Einfach perfekt, großes, sehr sauberes Zimmer, sauberes Bad, sehr
            nette Gastgeber und das Frühstück war einfach mega, alles vorhanden,
            zusätzlich Obst und angemachter Quark und so reichlich, wir waren
            lange satt. Wir haben schon bedauert, hier nur für eine Nacht
            Zwischenstopp gemacht zu haben!"
          </p>
          <div class="pt-4 border-t border-gray-50">
            <p class="font-bold text-gray-900 text-sm">April W.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MAP SECTION -->
  <section class="h-100 w-full relative">
    <PrivacyMap url={site.map_url} />
  </section>
</Layout>
